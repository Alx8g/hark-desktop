; Hark Desktop installer wording.
;
; Tauri includes this file before the installer pages are declared, so these
; defines theme the welcome and finish pages. The images are branding/build.mjs output.

!define MUI_WELCOMEPAGE_TITLE "Welcome to Hark Desktop"
!define MUI_WELCOMEPAGE_TEXT "This puts Hark on your PC. It takes a few seconds and needs no admin rights.$\r$\n$\r$\nHark Desktop is an unofficial app. Your account and everything in it stay on hark.com.$\r$\n$\r$\nClick Next to continue."

!define MUI_FINISHPAGE_TITLE "Hark is ready"
!define MUI_FINISHPAGE_TEXT "Hark will wait in your tray and open when you need it. Press Ctrl+Shift+H any time to ask something quickly.$\r$\n$\r$\nClick Finish to close this window."
!define MUI_FINISHPAGE_RUN_TEXT "Open Hark now"
