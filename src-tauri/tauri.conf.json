{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hark",
  "version": "0.2.1",
  "identifier": "com.harkwindows.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "publisher": "Hark Desktop contributors",
    "copyright": "Unofficial client, not affiliated with Hark. MIT licensed.",
    "license": "MIT",
    "shortDescription": "Hark Desktop",
    "longDescription": "A lightweight, unofficial desktop client for Hark (hark.com). Your real Hark account (chat, Projects, Panels and Handoff) in a fast native shell with tray residence, native notifications and live Handoff plan progress.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "macos/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 200
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "windows/sidebar.bmp",
        "headerImage": "windows/header.bmp",
        "uninstallerHeaderImage": "windows/header.bmp",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
