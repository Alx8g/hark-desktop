# Security headers for the website (read by Cloudflare Pages).
# The page loads only its own scripts, styles and images. The one outside request is the browser
# asking GitHub's public API for the latest release, so the download buttons can link to the right file.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src https://api.github.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# The page, stylesheet and script change with every deploy, so browsers must check before reusing them.
# (Cloudflare otherwise lets browsers keep static files for 4 hours, which shows a new page with an old stylesheet.)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/assets/site.css
  Cache-Control: no-cache
/assets/site.js
  Cache-Control: no-cache
